# AceProxy 生产环境配置
# 复制此文件为 .env 并填入真实值

# 数据库 (SQLite — 无需额外配置)
DATABASE_URL="file:./prisma/ace_proxy.db"

# JWT
JWT_SECRET=替换为随机32位字符串
JWT_EXPIRATION=7d

# Xendit 支付 (KYC 通过后填写)
XENDIT_API_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_WEBHOOK_SECRET=
XENDIT_ENV=sandbox

# 1688 API (注册 open.1688.com 后填写)
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_ACCESS_TOKEN=
ALIBABA_API_IS_SANDBOX=false

# Ollama AI (可选，没有就不跑AI模块)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# 服务
PORT=3001
NODE_ENV=production
CORS_ORIGINS=https://aceproxy.id,https://d019ff30096a420ca632cabf74b4c5f6.app.codebuddy.work
