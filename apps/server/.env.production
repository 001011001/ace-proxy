# AceProxy 生产环境配置
# 复制此文件为 .env 并填入真实值

# 数据库 (Supabase PostgreSQL — 生产环境必须使用)
# 注册 Supabase → 创建项目 → 获取连接字符串
# 文档: https://supabase.com/docs/guides/database/connecting-to-postgres
DB_PROVIDER=postgresql
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT].supabase.co:6543/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Supabase Auth (Project → Settings → API)
SUPABASE_URL=https://[PROJECT-ID].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT (必须填写！)
JWT_SECRET=CHANGE_ME_TO_RANDOM_32_CHAR_STRING
JWT_EXPIRATION=7d

# Xendit 支付 (KYC 通过后填写)
XENDIT_API_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_WEBHOOK_SECRET=
XENDIT_ENV=sandbox

# 1688 API (注册 open.1688.com 后填写)
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_ACCESS_TOKEN=
ALIBABA_API_IS_SANDBOX=false

# Ollama AI (可选，没有就不跑AI模块)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# 服务
PORT=3001
NODE_ENV=production
CORS_ORIGINS=https://aceproxy.id
