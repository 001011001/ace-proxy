# Database — SQLite for local dev, PostgreSQL for production/Supabase
DB_PROVIDER=postgresql
DATABASE_URL=postgresql://user:password@localhost:5432/aceproxy_vault

# Supabase (sign up at https://supabase.com)
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRATION=7d

# Xendit (fill in after registration)
XENDIT_API_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_WEBHOOK_SECRET=

# 1688 API (Alibaba Open Platform)
# 注册流程：open.1688.com → 企业实名 → 创建应用 → 获取 Key
# Token 获取：npx ts-node scripts/get-1688-token.ts
# 文档：https://open.1688.com/doc/openIndex.htm
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_ACCESS_TOKEN=
ALIBABA_API_IS_SANDBOX=false
ACE_PROXY_DEV_MOCK=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# App
PORT=3000

# Ollama AI
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
